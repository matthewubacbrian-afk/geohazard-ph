# Copy to .env.staging on the staging host and replace every example value.
IMAGE_PREFIX=ghcr.io/owner/geohazard-ph
IMAGE_TAG=0000000000000000000000000000000000000000
SITE_DOMAIN=staging.example.com
POSTGRES_PASSWORD=replace-with-a-strong-password
# URL-encode special characters in the database password here.
DATABASE_URL=postgresql+psycopg://geohazard:replace-with-a-strong-password@postgres:5432/geohazard
CORS_ORIGINS=["https://staging.example.com"]
# After domain review, set RISK_PROFILE_EXPORT_FILE to a validated, versioned export
# and deploy with --with-profile. Leave it unset while the export is on hold.
# RISK_PROFILE_EXPORT_FILE=./deploy-data/risk_profiles_RELEASESHA.json
INGEST_POLL_INTERVAL_SECONDS=300
